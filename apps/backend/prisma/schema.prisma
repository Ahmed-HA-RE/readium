generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum ReportReason {
  SPAM
  RULES_VIOLATION
  HARASSMENT
  AI_GENERATED
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum ModerationAction {
  WARNING
  TEMPORARY_BAN
  PERMANENT_BAN
}

enum NotificationType {
  NEW_COMMENT
  NEW_LIKE
  NEW_REPORT
}

model User {
  id               String    @id
  name             String    @unique
  email            String    @unique
  emailVerified    Boolean   @default(false)
  image            String?
  bio              String?
  website          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  role             String?
  banned           Boolean?  @default(false)
  banReason        String?
  banExpires       DateTime?
  twoFactorEnabled Boolean?  @default(false)
  stripeCustomerId String?

  // Last time the user made an authenticated request. Refreshed at most once
  // every 15 minutes by LastActivityInterceptor, and used to count active users.
  lastActivityAt DateTime?

  // Relations
  sessions      Session[]
  accounts      Account[]
  blogs         Blog[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  reports       Report[]
  twofactors    TwoFactor[]

  notifications          Notification[] @relation("NotificationRecipient") // Notifications this user receives
  triggeredNotifications Notification[] @relation("NotificationActor") // Notifications this user's actions created

  @@index([lastActivityAt])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  impersonatedBy String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  issuer String

  @@unique([issuer, accountId], map: "account_issuer_accountId_uidx")
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Blog {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  shortDescription String
  content          String
  tags             String[]
  coverImage       String?
  isPublished      Boolean  @default(false)
  blogPro          Boolean  @default(false)
  authorId         String
  author           User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  likesCount       Int      @default(0)

  // Relations
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  report        Report[]
  notifications Notification[]

  @@index([authorId])
  @@index([isPublished])
  @@index([isPublished, likesCount])
  @@map("blog")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  authorId  String
  blogId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  author        User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  blog          Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([authorId, blogId])
  @@index([blogId, createdAt])
  @@map("comment")
}

model Like {
  id        String   @id @default(uuid())
  userId    String
  blogId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@index([blogId])
  @@map("like")
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  blogId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog Blog @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@unique([userId, blogId])
  @@index([blogId])
  @@map("bookmark")
}

model Report {
  id        String            @id @default(uuid())
  reason    ReportReason
  status    ReportStatus      @default(PENDING)
  // Set only when the report is resolved; a ban here keeps the blog from being republished.
  action    ModerationAction?
  userId    String
  blogId    String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  // Relations
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  blog          Blog           @relation(fields: [blogId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([userId, blogId])
  @@index([blogId])
  @@map("report")
}

model TwoFactor {
  id                      String    @id
  secret                  String
  backupCodes             String
  userId                  String
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified                Boolean?  @default(true)
  failedVerificationCount Int?      @default(0)
  lockedUntil             DateTime?

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}

model Subscription {
  id                   String    @id
  plan                 String
  referenceId          String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  status               String    @default("incomplete")
  periodStart          DateTime?
  periodEnd            DateTime?
  trialStart           DateTime?
  trialEnd             DateTime?
  cancelAtPeriodEnd    Boolean?  @default(false)
  cancelAt             DateTime?
  canceledAt           DateTime?
  endedAt              DateTime?
  seats                Int?
  billingInterval      String?
  stripeScheduleId     String?

  @@index([referenceId])
  @@index([stripeSubscriptionId])
  @@map("subscription")
}

model Notification {
  id          String           @id @default(uuid())
  type        NotificationType
  recipientId String
  actorId     String
  blogId      String
  commentId   String?
  reportId    String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  // Relations
  recipient User     @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade) // Who receives the notification
  actor     User     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade) // Who triggered it by commenting, liking or reporting
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  report    Report?  @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
  @@map("notification")
}
