# Each app reads its own env file. Copy the Backend section into `apps/backend/.env`
# and the Frontend section into `apps/web/.env`, then fill in the values.

# ─────────────────────────────────────────────────────────────
# Backend (apps/backend/.env)
# ─────────────────────────────────────────────────────────────

# Server
PORT=3001
NODE_ENV=development

# Database (Neon Postgres)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
# Shared cookie domain in production (e.g. ".example.com"); leave empty locally.
COOKIE_DOMAIN=

# OAuth providers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# App origins (CORS, socket.io and email links)
APP_BACKEND_URL="http://localhost:3001"
APP_FRONTEND_URL="http://localhost:3000"

# Email (Resend); emails are sent from noreply@EMAIL_DOMAIN
RESEND_API_KEY=
EMAIL_DOMAIN="example.com"

# Image uploads (AWS S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="us-east-1"
AWS_BUCKET_NAME=

# Stripe (use test-mode keys locally)
STRIPE_SECRET_KEY="sk_test_..."
# Signing secret of the dashboard webhook endpoint (production).
STRIPE_WEBHOOK_SECRET="whsec_..."
# Signing secret printed by `stripe listen` (development).
STRIPE_WEBHOOK_SECRET_DEV="whsec_..."
# 20% off coupon applied to a first yearly subscription.
STRIPE_COUPON_ID_20=
PRO_PLAN_NAME="pro"
PRO_PLAN_PRICE_ID="price_..."
PRO_ANNUAL_DISCOUNT_PRICE_ID="price_..."

# ─────────────────────────────────────────────────────────────
# Frontend (apps/web/.env)
# ─────────────────────────────────────────────────────────────

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# NestJS API
NEXT_PUBLIC_API_URL="http://localhost:3001/api"
# Better Auth mount point on the backend
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3001/api/auth"
# Backend origin with no path (socket.io reads a path as a namespace)
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
# Stripe dashboard links in the admin payments page (live in production, test elsewhere)
NEXT_PUBLIC_STRIPE_LIVE_URL="https://dashboard.stripe.com"
NEXT_PUBLIC_STRIPE_TEST_URL="https://dashboard.stripe.com/test"
